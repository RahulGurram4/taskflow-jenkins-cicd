# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real credentials.

# ---- Docker Hub image coordinates (used by docker-compose.yml) ----
DOCKERHUB_USERNAME=myusername
IMAGE_TAG=1.0.0

# ---- Postgres ----
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=4000
# These map into the backend container as DB_* — see docker-compose.yml
DB_HOST=db
DB_PORT=5432
DB_USER=taskflow
DB_PASSWORD=change_me_please
DB_NAME=taskflow

# ---- Frontend ----
FRONTEND_PORT=8080
# Build-time only: baked into the JS bundle when the frontend image is built.
# Default /api works out of the box because nginx.conf proxies /api to the
# backend service — only change this if the backend lives on a different origin.
VITE_API_BASE_URL=/api
